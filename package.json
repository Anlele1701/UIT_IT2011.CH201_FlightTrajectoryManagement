{
  "name": "project",
  "version": "1.0.0",
  "description": "Flight trajectory backend with Express, TypeORM, PostGIS, and TimescaleDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:reference-data": "node --require ts-node/register src/scripts/seed-reference-data.ts",
    "import:airspace-zone": "node --require ts-node/register src/scripts/import-airspace-zone.ts",
    "import:opensky-state-file": "node --require ts-node/register src/scripts/import-opensky-state-file.ts",
    "db:reset": "psql \"postgresql://${DB_USER:-postgres}:${DB_PASSWORD:-postgres}@${DB_HOST:-localhost}:${DB_PORT:-5432}/${DB_NAME:-flight_trajectory}\" -f sql/reset_database.sql",
    "db:import:opensky-csv": "psql \"postgresql://${DB_USER:-postgres}:${DB_PASSWORD:-postgres}@${DB_HOST:-localhost}:${DB_PORT:-5432}/${DB_NAME:-flight_trajectory}\" -f sql/import_opensky_state_vectors.sql",
    "db:remigrate:opensky-csv": "npm run db:reset && npm run migration:run && npm run db:import:opensky-csv",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js -d src/config/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "pg": "^8.16.3",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
